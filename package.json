{
  "name": "therascript",
  "version": "0.1.0",
  "description": "Lokale Therapiesitzungs-Transkription & Anonymisierung für macOS",
  "main": "./out/main/index.js",
  "author": "Adrian Bader",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "SDKROOT=$(xcrun --show-sdk-path) electron-rebuild -f -w better-sqlite3",
    "predev": "SDKROOT=$(xcrun --show-sdk-path) electron-rebuild -f -w better-sqlite3",
    "pretest": "SDKROOT=$(xcrun --show-sdk-path) npm rebuild better-sqlite3",
    "pretest:watch": "SDKROOT=$(xcrun --show-sdk-path) npm rebuild better-sqlite3",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --mac --config"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
